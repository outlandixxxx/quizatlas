*.backup
*.save
*.zip
*.tar
*.tar.gz
*.tgz
/.local-backups/
/backend/storage/framework/*
/backend/storage/logs/*
/frontend/artifacts/

# Historical local snapshots stay private. These two public-response fixtures
# are read by permanent Laravel regression tests and must ship with the code.
/backend/artifacts/*
!/backend/artifacts/wadifa-info-evaluation/
/backend/artifacts/wadifa-info-evaluation/*
!/backend/artifacts/wadifa-info-evaluation/api-sample.json
!/backend/artifacts/concours-phase5f-final-verification/
/backend/artifacts/concours-phase5f-final-verification/*
!/backend/artifacts/concours-phase5f-final-verification/response-summary.json

# Required synthesized sound-effect inputs, not rendered media or custom music.
!video-generator/assets/audio/tick.wav
!video-generator/assets/audio/tick-urgent.wav
!video-generator/assets/audio/chime.wav
!video-generator/assets/audio/whoosh.wav
!video-generator/assets/audio/sting.wav
!video-generator/assets/audio/pop.wav
!fact-generator/assets/audio/chime.wav
!fact-generator/assets/audio/pop.wav
!fact-generator/assets/audio/whoosh.wav
!fact-generator/assets/audio/tick.wav

# Local generators are versioned, but their ad-hoc render products are not.
