{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "test:landing": "ng test --watch=false --ts-config=tsconfig.landing-spec.json --include=\"src/app/features/public/majors-subjects-browser/*.spec.ts\" --include=\"src/app/features/public/quiz-dashboard-grid/*.spec.ts\" --include=\"src/app/features/landing/pages/landing/landing.spec.ts\" --include=\"src/app/features/public/progression-showcase/progression-showcase.spec.ts\" --include=\"src/app/features/public/stats-ribbon/stats-ribbon.spec.ts\" --runner-config=vitest.style.config.mjs",
    "test:login": "ng test --watch=false --ts-config=tsconfig.login-spec.json --include=\"src/app/features/auth/components/login-form/login-form.spec.ts\"",
    "test:style": "ng test --watch=false --ts-config=tsconfig.style-spec.json --runner-config=vitest.style.config.mjs --include=\"src/app/features/auth/components/login-form/login-form.spec.ts\" --include=\"src/app/features/public/majors-subjects-browser/majors-subjects-browser.spec.ts\" --include=\"src/app/features/public/quiz-dashboard-grid/quiz-dashboard-grid.spec.ts\" --include=\"src/app/shared/components/ui/text-field/text-field.spec.ts\" --include=\"src/app/shared/components/ui/password-field/password-field.spec.ts\" --include=\"src/app/shared/components/ui/primary-button/primary-button.spec.ts\" --include=\"src/app/shared/components/ui/checkbox/checkbox.spec.ts\" --include=\"src/app/features/landing/pages/landing/landing.spec.ts\" --include=\"src/app/features/public/progression-showcase/progression-showcase.spec.ts\" --include=\"src/app/features/public/stats-ribbon/stats-ribbon.spec.ts\" --include=\"src/app/shared/components/ui/logo/logo.spec.ts\""
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.23",
    "@jsverse/transloco": "^8.4.0",
    "express": "^5.1.0",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
