# Build contexts contain release inputs only. Git ignore rules do not protect COPY.
**
!backend/
!backend/artisan
!backend/composer.json
!backend/composer.lock
!backend/app/
!backend/app/**
!backend/bootstrap/
!backend/bootstrap/*.php
!backend/config/
!backend/config/**
!backend/database/
!backend/database/migrations/
!backend/database/migrations/**
!backend/database/seeders/
!backend/database/seeders/**
!backend/public/
!backend/public/**
!backend/resources/
!backend/resources/**
!backend/routes/
!backend/routes/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/angular.json
!frontend/tsconfig*.json
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!infrastructure/
!infrastructure/docker/
!infrastructure/docker/**

# Exclude these even if someone puts them inside an allowed source directory.
**/.env
**/.env.*
**/vendor
**/node_modules
**/.git
**/storage
**/bootstrap/cache
