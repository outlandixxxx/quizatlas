APP_NAME=MaroQuiz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.maroquiz.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=maroquiz
DB_USERNAME=postgres
DB_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
REDIS_PORT=6379

# Real transactional mail provider — Mailpit is dev-only and removed in prod (H4)
MAIL_MAILER=smtp
MAIL_HOST=__YOUR_SMTP_PROVIDER_HOST__
MAIL_PORT=587
MAIL_USERNAME=__YOUR_SMTP_USERNAME__
MAIL_PASSWORD=__YOUR_SMTP_PASSWORD__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@maroquiz.com
MAIL_FROM_NAME="MaroQuiz"

JWT_SECRET=
JWT_ALGO=HS256

FRONTEND_URL=https://maroquiz.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Docker Compose only (not read by Laravel directly)
POSTGRES_DB=maroquiz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
